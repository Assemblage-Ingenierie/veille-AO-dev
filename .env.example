# ── Identifiants GIZ / DTVP (Keycloak) ───────────────────────────────────────
# Créer un compte gratuit sur https://ausschreibungen.giz.de
# puis copier ce fichier en ".env" et renseigner vos identifiants.
GIZ_USERNAME=votre.email@example.com
GIZ_PASSWORD=votre_mot_de_passe

